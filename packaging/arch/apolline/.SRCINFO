pkgbase = apolline
	pkgdesc = A desktop shell for niri: bar, launcher, quick settings, lock and login screens, themes and modes
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/Pisosenie/apolline
	install = apolline.install
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	makedepends = clang
	depends = niri
	depends = vif
	depends = pam
	depends = libxkbcommon
	depends = libgcc
	depends = glibc
	depends = hicolor-icon-theme
	optdepends = wireplumber: volume in quick settings
	optdepends = libpulse: the volume on the bar follows changes made elsewhere
	optdepends = networkmanager: Wi-Fi in quick settings
	optdepends = bluez: Bluetooth in quick settings
	optdepends = brightnessctl: brightness in quick settings
	optdepends = upower: battery in the bar
	optdepends = pacman-contrib: waiting updates on the bar (checkupdates)
	optdepends = power-profiles-daemon: performance profiles in modes
	optdepends = polkit: the admin password dialog
	optdepends = greetd: the login screen, apolline greet
	optdepends = cage: a kiosk compositor to run apolline greet in
	optdepends = wf-recorder: screen recording from the launcher
	optdepends = gpu-screen-recorder: a mode can keep the last moments of a game
	optdepends = sound-theme-freedesktop: the sound notifications can make
	optdepends = xdg-terminal-exec: apps that open a terminal open vif
	optdepends = apolline-wall-git: videos, shaders and Wallpaper Engine scenes as the wallpaper
	optdepends = cosmic-files: a file manager in Rust and iced, like Apolline
	optdepends = yazi: a file manager inside vif
	conflicts = apolline-git
	options = !lto
	backup = etc/pam.d/apolline
	source = apolline-0.3.0.tar.gz::https://github.com/Pisosenie/apolline/archive/v0.3.0.tar.gz
	sha256sums = 5e0dd48b8c6e5a9446ec5416d8a4ce86920aa3b0ee3d1ac402f34cd531f16afe

pkgname = apolline
