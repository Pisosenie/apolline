pkgbase = apolline-desktop
	pkgdesc = The whole Apolline desktop on a bare Arch: the shell, niri, sound, network, Bluetooth, login screen, files and fonts
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/Pisosenie/apolline
	install = apolline-desktop.install
	arch = any
	license = MIT OR Apache-2.0
	depends = apolline
	depends = niri
	depends = vif
	depends = xwayland-satellite
	depends = xdg-desktop-portal-gnome
	depends = xdg-desktop-portal-gtk
	depends = xdg-user-dirs
	depends = xdg-utils
	depends = xdg-terminal-exec
	depends = pipewire
	depends = pipewire-pulse
	depends = wireplumber
	depends = libpulse
	depends = networkmanager
	depends = bluez
	depends = bluez-utils
	depends = upower
	depends = power-profiles-daemon
	depends = brightnessctl
	depends = polkit
	depends = greetd
	depends = cage
	depends = cosmic-files
	depends = yazi
	depends = gvfs
	depends = wl-clipboard
	depends = grim
	depends = slurp
	depends = wf-recorder
	depends = pacman-contrib
	depends = sound-theme-freedesktop
	depends = noto-fonts
	depends = noto-fonts-cjk
	depends = noto-fonts-emoji
	depends = ttf-nerd-fonts-symbols
	optdepends = gpu-screen-recorder: a mode can keep the last moments of a game
	optdepends = fprintd: unlocking with a finger
	optdepends = flatpak: Flatpak apps in the launcher

pkgname = apolline-desktop
