# btop in Apolline's colors. Pick "apolline" in btop's options; it rereads its theme on SIGUSR2.
theme[main_bg]="{{window}}"
theme[main_fg]="{{text}}"
theme[title]="{{text}}"
theme[hi_fg]="{{accent}}"
theme[selected_bg]="{{accent}}"
theme[selected_fg]="{{on_accent}}"
theme[inactive_fg]="{{faint}}"
theme[graph_text]="{{muted}}"
theme[meter_bg]="{{border}}"
theme[proc_misc]="{{accent}}"
theme[cpu_box]="{{border}}"
theme[mem_box]="{{border}}"
theme[net_box]="{{border}}"
theme[proc_box]="{{border}}"
theme[div_line]="{{border}}"
theme[temp_start]="{{good}}"
theme[temp_mid]="{{warn}}"
theme[temp_end]="{{danger}}"
theme[cpu_start]="{{good}}"
theme[cpu_mid]="{{warn}}"
theme[cpu_end]="{{danger}}"
theme[free_start]="{{good}}"
theme[cached_start]="{{accent}}"
theme[available_start]="{{good}}"
theme[used_start]="{{warn}}"
theme[download_start]="{{accent}}"
theme[upload_start]="{{warn}}"
